# Personal API Key creada en https://connect.garmin.com/app/settings/personalApiToken
GARMIN_API_KEY=

# Secreto que deben enviar los clientes MCP (Authorization: Bearer ... o ?token=...)
# Genera uno con: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Opcional: usa https://personal.connectapi.garmin.cn para cuentas de Garmin China
# GARMIN_API_BASE_URL=https://personal.connectapi.garmin.com
